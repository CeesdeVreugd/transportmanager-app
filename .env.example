# Overzicht van de omgevingsvariabelen. Bij de Portainer-opzet wordt dit
# bestand NIET gebruikt: vul deze waarden in bij de stack, onder
# "Environment variables". Alles is optioneel — zonder waarde blijft de app
# werken, alleen staat die functie dan uit.
#
# TIP: kopieer de waarden uit de oude omgeving (Railway → Variables).

# Publiek adres (bepaalt ook of cookies Secure zijn)
APP_URL=https://transportmanager.devreugd-pt.nl
# Eerste beheerder (wordt bij de start aangemaakt als dit account nog niet bestaat)
ADMIN_EMAIL=
ADMIN_NAME=Cees de Vreugd
# Lange willekeurige tekst (min. 40 tekens). Niet meer wijzigen: anders is iedereen uitgelogd.
# Leeg = de app maakt er zelf een in /data/secret_key.
SECRET_KEY=

# E-mail via de app-registratie in Microsoft 365 (zelfde als WorkPortal, Mail.Send)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_FROM=

# Pushmeldingen (gebruik DEZELFDE sleutels als in de oude omgeving)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=info@devreugd-dt.nl

# OpenRouteService: automatische afstand, kaart en volgorde-optimalisatie
ORS_API_KEY=

# Resend: alternatief voor mail als GRAPH_* leeg is
RESEND_API_KEY=
RESEND_AFZENDER=

# OneDrive-back-ups (app-registratie in Microsoft Entra)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_TENANT_ID=common

# Geheugengrens van de container (standaard 1g)
TM_MEM_LIMIT=1g
